# .htaccess untuk root domain di Apache/cPanel.
# Salin ke public_html/.htaccess.
#
# PENTING: bila Anda memakai cPanel > Setup Node.js App, cPanel akan
# MENAMBAHKAN sendiri blok "PassengerAppRoot ... # DO NOT REMOVE" ke berkas ini.
# Jangan hapus blok tersebut — biarkan di atas, lalu simpan aturan di bawah ini
# setelah blok itu.

# --- Paksa HTTPS + hilangkan www (sesuaikan/nonaktifkan bila tidak perlu) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Kompresi ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Cache aset ber-hash (nama berkas mengandung hash, aman di-cache lama) ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|webp|avif|gif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Header keamanan dasar
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  # Aktifkan HSTS hanya setelah HTTPS berjalan stabil:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- MIME type ---
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# Jangan tampilkan daftar berkas
Options -Indexes
