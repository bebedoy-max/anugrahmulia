# ============================================================
# Konfigurasi produksi — hosting sendiri (HawkHost / cPanel + PostgreSQL)
# Salin berkas ini menjadi `.env` di root aplikasi, lalu sesuaikan nilainya.
# JANGAN unggah `.env` ke repository publik.
# ============================================================

# --- URL publik situs (dibaca saat BUILD, ikut ke bundel browser) ---
# Ganti dengan domain asli Anda, tanpa garis miring di akhir.
VITE_SITE_URL="https://anugerahmulia.com"

# --- Database PostgreSQL di hosting sendiri (HawkHost / cPanel) ---
# WAJIB: paksa aplikasi memakai PostgreSQL Anda (bukan database uji Lovable).
DATABASE_PROVIDER="postgres"
# Cara termudah: cukup isi DATABASE_URL saja.
DATABASE_URL="postgres://teknolo8_useranugrahmulia:Cilla112233!!@127.0.0.1:5432/teknolo8_anugrahmulia"

# Alternatif (dipakai bila DATABASE_URL dikosongkan):
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="teknolo8_anugrahmulia"
PGUSER="teknolo8_useranugrahmulia"
PGPASSWORD="Cilla112233!!"
# Database lokal di server yang sama tidak memakai SSL:
PGSSL="disable"
PGPOOL_MAX="8"

# --- Rahasia tanda tangan cookie sesi login (WAJIB diganti nilai acak) ---
# Buat nilai baru dengan: openssl rand -hex 32
AUTH_SECRET="ganti-dengan-64-karakter-acak-openssl-rand-hex-32"

# --- Folder penyimpanan berkas unggahan (foto properti, banner, video) ---
UPLOAD_DIR="./storage/uploads"

# --- Runtime Node ---
NODE_ENV="production"
# PORT dan HOST disuntik otomatis oleh cPanel/Passenger — biarkan tetap dikomentari.
# PORT=3000
# HOST="127.0.0.1"
